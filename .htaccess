# ============================================================
# CONFIGURACIÓN BÁSICA
# ============================================================
DirectoryIndex Login.html index.php index.html
Options -Indexes

# ============================================================
# COMPRESIÓN GZIP
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/plain text/xml application/xml
</IfModule>

# ============================================================
# CACHÉ DE NAVEGADOR
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# ============================================================
# ✅ ELIMINAR EL PARÁMETRO ?i=1 (CAUSA DEL AVISO DE GOOGLE)
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Si la URL contiene ?i=1 o ?i=N, redirigir 301 a la URL limpia
    RewriteCond %{QUERY_STRING} ^(.*)i=[0-9]+(.*)$ [NC]
    RewriteRule ^(.*)$ /$1?%1%2 [R=301,L]
    
    # Redirigir la raíz a Login.html
    RewriteRule ^$ Login.html [L]
</IfModule>

# ============================================================
# SEGURIDAD BÁSICA
# ============================================================
# Proteger archivos sensibles
<FilesMatch "^(config|conexion)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Proteger el archivo .htaccess
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>